[Unit]
Description=the fleet's reviewer: one headless review round for project %i (fleet-kit)
Documentation=https://github.com/haku767/fleet-kit
ConditionPathExists={home_root}/{reviewer}/.local/bin/claude
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={reviewer}
WorkingDirectory={home_root}/{reviewer}
# bot-review sets HOME, PATH and the rest itself; the log is its own ({home_root}/{reviewer}/log/)
# BOT_REVIEW_MAX, BOT_REVIEW_TURNS, BOT_REVIEW_BUDGET in /etc/default/bot-review change the caps
EnvironmentFile=-/etc/default/bot-review
ExecStart=/usr/local/bin/bot-review --project %i
TimeoutStartSec=1h30m
Nice=10
